{
  "name": "burraco-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Burraco - gioco di carte italiano come PWA, con bot e gioco online multiplayer.",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5"
  }
}
